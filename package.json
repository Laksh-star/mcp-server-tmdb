{
  "name": "mcp-server-tmdb",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && node scripts/concierge-offline-test.mjs && node scripts/planning-offline-test.mjs && node scripts/radar-offline-test.mjs && node scripts/coverage-offline-test.mjs && node scripts/doctor-test.mjs",
    "build": "tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "worker:dev": "node scripts/sync-dev-vars.mjs && wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "install:local": "node plugins/tmdb/scripts/install-local-integrations.mjs",
    "smoke:plugin": "node plugins/tmdb/scripts/smoke-test.mjs",
    "smoke:concierge": "node scripts/concierge-smoke.mjs",
    "smoke:tools": "node scripts/tool-surface-smoke.mjs",
    "demo:weekly-trending": "node scripts/weekly-trending-languages.mjs",
    "demo:now-playing": "node scripts/now-playing-follow-on-demo.mjs",
    "demo:weekly-radar": "node scripts/weekly-streaming-radar.mjs",
    "demo:release-calendar": "node scripts/release-calendar-watchlist.mjs",
    "demo:provider-monitor": "node scripts/provider-change-monitor.mjs",
    "demo:collection-gaps": "node scripts/collection-gap-finder.mjs",
    "doctor": "node scripts/doctor.mjs",
    "docker:build": "docker build -t mcp-server-tmdb:local .",
    "smoke:docker": "node scripts/docker-smoke.mjs",
    "test:http": "node scripts/http-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "tmdb",
    "movies",
    "tv",
    "streaming",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "description": "Movie and TV discovery, watch planning, and availability radar for MCP clients, with a browser app and Cloudflare Worker transport.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-fetch": "^3.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.10.1",
    "@types/node-fetch": "^2.6.12",
    "shx": "^0.4.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.159.0"
  },
  "type": "module",
  "bin": {
    "mcp-server-tmdb": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
